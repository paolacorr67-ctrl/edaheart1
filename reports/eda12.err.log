# 13. Threshold tuning del mejor modelo 
y_scores = mejor_grid.predict_proba(X_test)[:, 1]
thresholds = np.linspace(0.1, 0.9, 100)
recalls_t, precisions_t, f1s_t = [], [], []

for t in thresholds:
    y_pred_t = (y_scores >= t).astype(int)
